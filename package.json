{
  "name": "riga",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test": "vitest run --coverage",
    "dev": "concurrently --kill-others --names kernel,web \"./scripts/run-kernel.sh\" \"npm run dev --workspace @riga/desktop-ui -- --host 0.0.0.0\"",
    "start": "npm run dev",
    "tauri": "npm run tauri --workspace @riga/desktop-ui",
    "tauri:dev": "npm run tauri:dev --workspace @riga/desktop-ui",
    "tauri:build": "npm run tauri:build --workspace @riga/desktop-ui"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
