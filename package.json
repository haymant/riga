{
  "name": "riga",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test": "vitest run --coverage",
    "dev": "npm run dev --prefix demo",
    "start": "npm run dev",
    "cli:cuda": "node scripts/riga-cuda.mjs",
    "tauri": "npm run tauri --prefix demo",
    "tauri:dev": "npm run tauri:dev --prefix demo",
    "tauri:build": "npm run tauri:build --prefix demo",
    "tauri:dev:cuda": "npm run tauri:dev:cuda --prefix demo",
    "tauri:build:cuda": "npm run tauri:build:cuda --prefix demo"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0"
  }
}
